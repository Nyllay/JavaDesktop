<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.interfase.grafico.controllers.MainController"
      spacing="10" alignment="CENTER" prefWidth="300" prefHeight="200">

    <Label fx:id="label" text="Formulário de Cadastro"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Nome:" minWidth="80"/>
        <TextField fx:id="nomeField" promptText="Digite seu nome" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Email:" minWidth="80"/>
        <TextField fx:id="emailField" promptText="Digite seu e-mail" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Idade:" minWidth="80"/>
        <TextField fx:id="idadeField" promptText="Digite sua idade" />
    </HBox>

    <Button text="pega na bichona" onAction="#handleEnviar"/>
    
</VBox>
